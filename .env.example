# Pooled connection (PgBouncer) — application query traffic
DATABASE_URL="postgresql://user:password@localhost:5432/feedback-system?schema=public"
# Direct connection — migrations only (prisma migrate / prisma db use this automatically)
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/feedback-system?schema=public"
# Neon branch name (written by `neon deploy`)
NEON_BRANCH="production"

# Base URL of the feedback app (frontend only — used to resolve project paths like /:organizationSlug/:projectSlug)
# localhost: http://localhost:5173
# development: https://dev.feedback.com
# production: https://app.feedback.com
FEEDBACK_APP_URL="http://localhost:5173"
