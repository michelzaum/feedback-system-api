# Which database the app and Prisma CLI use: "local" (default) or "production".
# Leave unset for local development. To point the app, `prisma migrate` or
# `prisma db` at the production Neon database, set DATABASE_TARGET=production
# here or as an OS env var. The deployed Neon runtime and `neon-env run`
# inject DATABASE_URL themselves, so they resolve to production on their own.
# DATABASE_TARGET=production

# Local development database (default target)
# Pooled/unpooled distinction only matters for Neon; locally they are the same.
DATABASE_URL_LOCAL="postgresql://user:password@localhost:5432/feedback-system?schema=public"
DATABASE_URL_UNPOOLED_LOCAL="postgresql://user:password@localhost:5432/feedback-system?schema=public"

# Production database (Neon branch "production") — pooled connection
# (PgBouncer) for app query traffic, direct connection for migrations.
# Also what `neon deploy` / `neon env pull` write as DATABASE_URL /
# DATABASE_URL_UNPOOLED; kept here under explicit _PRODUCTION names for
# manual opt-in via DATABASE_TARGET=production.
DATABASE_URL_PRODUCTION="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED_PRODUCTION="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Neon branch name (written by `neon deploy`)
NEON_BRANCH="production"

# Auth
JWT_SECRET="change-me"

# Base URL of the feedback app (frontend only — used to resolve project paths like /:organizationSlug/:projectSlug)
# localhost: http://localhost:5173
# development: https://dev.feedback.com
# production: https://app.feedback.com
FEEDBACK_APP_URL="http://localhost:5173"
